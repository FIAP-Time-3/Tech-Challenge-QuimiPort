APP_PORT=3010
SWAGGER_TITLE=QuimiPort API (DevOps)
SWAGGER_DESCRIPTION=Rest API created for QuimiPort Project (DevOps)
SWAGGER_VERSION=0.1.0

DATABASE_HOSTNAME=postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_PORT=5432
DATABASE_NAME=quimiport

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/quimiport?schema=public

NODE_TLS_REJECT_UNAUTHORIZED=0

PASSWORD_SALT=10
JWT_SECRET=create_good_secret_here
# Duração dos tokens em minutos
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_MINUTES=4320

# Banco exclusivo dos testes de integração
TEST_DATABASE_HOSTNAME=postgres-test
TEST_DATABASE_PORT=5432
TEST_DATABASE_NAME=quimiport_test
TEST_DATABASE_USERNAME=quimiport_test
TEST_DATABASE_PASSWORD=quimiport_test
