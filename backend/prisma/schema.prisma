// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/infra/database/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ProdutosQuimicos {
  id            Int             @id @default(autoincrement())
  nome          String          @unique
  descricao     String?
  classeRisco   Int
  status        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  cargaQuimicas CargaQuimicas[]
}

model CargaQuimicas {
  id                 Int               @id @default(autoincrement())
  produtoQuimicoId   Int
  produtoQuimico     ProdutosQuimicos  @relation(fields: [produtoQuimicoId], references: [id])
  quantidade         Int
  unidadeMedida      String
  origem             String            @default("NAO INFORMADA")
  destino            String
  responsavelTecnico String            @default("NAO INFORMADO")
  dataEntrada        DateTime          @default(now())
  statusCarga        String
  classeRiscoONU     Int
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  movimentacoes      Movimentacoes[]
  documentoCargases  DocumentoCargas[]
  inspecoes          Inspecoes[]
}

model Movimentacoes {
  id             Int           @id @default(autoincrement())
  cargaQuimicaId Int
  cargaQuimica   CargaQuimicas @relation(fields: [cargaQuimicaId], references: [id])
  step           Int
  statusAnterior String?
  notes          String?
  statusAtual    String
  usuarioId      Int?
  date           DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([cargaQuimicaId, step])
}

model DocumentoCargas {
  id             Int           @id @default(autoincrement())
  cargaQuimicaId Int
  cargaQuimica   CargaQuimicas @relation(fields: [cargaQuimicaId], references: [id])
  tipoDocumento  String
  validado       Boolean
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([cargaQuimicaId, tipoDocumento])
}

model Inspecoes {
  id                Int           @id @default(autoincrement())
  cargaQuimicaId    Int
  cargaQuimica      CargaQuimicas @relation(fields: [cargaQuimicaId], references: [id])
  resultadoInspecao String
  observacoes       String
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model User {
  id       Int      @id @default(autoincrement())
  username String   @unique
  name     String
  password String
  roles    String[]
  status   Boolean  @default(true)
}
